FROM nginx:alpine

# The front is not a static file server any more: it renders its own config and page from the
# environment, so it needs a shell script and the two templates rather than two finished files.
COPY --chmod=0755 docker-entrypoint.nginx.sh /docker-entrypoint.nginx.sh
COPY nginx.conf.template index.html.template /usr/share/slopyphus/

# Replacing the image's own entrypoint (which only substitutes whole-environment-variable templates)
# is the point: the number of upstreams and panes is not a fixed set of variables.
ENTRYPOINT ["/docker-entrypoint.nginx.sh"]
# Inherited CMD (nginx -g "daemon off;") is kept: the entrypoint renders, then execs it.
